# Starter runs without credentials. Never put secrets in VITE_* variables.
# Optional frontend dev proxy override (e.g. in Docker).
API_PROXY_TARGET=http://127.0.0.1:8000

# Backend only. Docker Compose reads the root .env file automatically.
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.6-flash
